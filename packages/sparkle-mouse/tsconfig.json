{
    // type checks only (npm run typecheck), the build doesn't use this
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom"],
        "strict": true,
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": false
    },
    "include": ["types", "test"]
}
