{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkle Mouse",
  "version": "1.0.13",
  "identifier": "com.maxvanleeuwen.sparkle-mouse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx dotenv-cli -e config.env -- vite"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Sparkle Mouse",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "acceptFirstMouse": false,
        "tabbingIdentifier": null,
        "focusable": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-angle=d3d11 --enable-gpu-rasterization --enable-zero-copy --disable-software-rasterizer --disable-gpu-driver-bug-workarounds"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "settings",
        "about"
      ]
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm"
    ],
    "category": "Entertainment",
    "shortDescription": "Sparkle Mouse",
    "longDescription": "Sparkle Mouse",
    "resources": [
      "attribution.txt"
    ],
    "fileAssociations": [
      {
        "name": "Sparkle Template",
        "ext": [
          "sparkle"
        ],
        "role": "Editor",
        "description": "Sparkle Mouse Template",
        "rank": "Owner"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "background": "icons/dmgBackground.tiff"
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/headerImage.bmp",
        "sidebarImage": "icons/sidebarImage.bmp"
      },
      "wix": {
        "dialogImagePath": null,
        "bannerPath": null
      }
    },
    "linux": {
      "rpm": {
        "recommends": [
          "gnome-shell-extension-appindicator"
        ]
      }
    }
  }
}
